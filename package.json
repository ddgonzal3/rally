{
  "name": "rally",
  "version": "1.0.0",
  "description": "Orchestrate multiple Claude Code sessions, git workflows, and dev processes across repo workspaces",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "cargo tauri",
    "app": "tsc && vite build && cargo tauri build --bundles app",
    "app:run": "tsc && vite build && cargo tauri build --bundles app && open src-tauri/target/release/bundle/macos/Rally.app",
    "app:dmg": "tsc && vite build && cargo tauri build --bundles app,dmg"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "@types/dompurify": "^3.0.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.3.1",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.3",
    "marked-highlight": "^2.2.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zustand": "^5.0.11"
  }
}
