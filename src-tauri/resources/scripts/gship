#!/bin/bash
# gship — Trigger /ship via Rally
# Installed to ~/.rally/bin/ by Rally on startup (always overwritten)

repo=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$repo" ]; then echo "Not in a git repository"; exit 1; fi

branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ -z "$branch" ]; then echo "Not on a branch"; exit 1; fi
if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
  echo "Cannot ship from $branch. Switch to a feature branch first."
  exit 1
fi

main_branch="main"
ahead=$(git rev-list --count "$main_branch".."$branch" 2>/dev/null)
if [ "$ahead" = "0" ] || [ -z "$ahead" ]; then
  echo "No commits ahead of $main_branch. Nothing to ship."
  exit 1
fi

mkdir -p ~/.rally/ship-triggers
printf '{"repo_path":"%s"}\n' "$repo" > ~/.rally/ship-triggers/$(date +%s).json
echo "Shipping $branch ($ahead commit(s) ahead of $main_branch) — check Rally for progress"
