#!/bin/bash
# gsync — Smart sync: rebase onto main, with hard-reset only when safe
# Installed to ~/.rally/bin/ by Rally on startup

branch=$(git symbolic-ref --short HEAD 2>/dev/null)
main_branch="main"

if [ -z "$branch" ]; then echo "Not in a git repo"; exit 1; fi
if [ "$branch" = "$main_branch" ]; then echo "Already on $main_branch"; exit 1; fi
if [ -n "$(git status --porcelain -uno)" ]; then
  echo "Working tree is dirty. Commit or stash your changes first."
  exit 1
fi

echo "Syncing $branch with $main_branch..."

git fetch || { echo "Failed to fetch"; exit 1; }
git checkout "$main_branch" || { echo "Failed to checkout $main_branch"; exit 1; }
git pull || { echo "Failed to pull $main_branch"; exit 1; }

# Remove stale index.lock — Nx daemon file watchers can race with checkout
rm -f .git/index.lock
git checkout "$branch" || { echo "Failed to checkout $branch"; exit 1; }

# Detect whether branch work is already in main (post-merge) or has real unmerged changes.
# `git diff main branch` compares the trees — empty means all work is merged.
diff_output=$(git diff --stat "$main_branch" "$branch")
if [ -z "$diff_output" ]; then
  already_merged=true
  echo "Branch work already in $main_branch (post-merge). Hard-resetting..."
  git reset --hard "$main_branch" || { echo "Failed to reset $branch"; exit 1; }
else
  already_merged=false
  echo "Branch has unmerged work. Rebasing only (no push)..."
fi

head_before=$(git rev-parse HEAD)
git rebase "$main_branch" || {
  git rebase --abort 2>/dev/null
  echo "Failed to rebase onto $main_branch"
  exit 1
}
head_after=$(git rev-parse HEAD)

if [ "$head_before" != "$head_after" ]; then
  # Push if the branch has a remote tracking branch
  if git rev-parse --verify "origin/$branch" &>/dev/null; then
    git push --force-with-lease 2>/dev/null || true
  fi
fi

if [ "$already_merged" = true ]; then
  echo "$branch synced with $main_branch (reset)."
else
  echo "$branch rebased onto $main_branch."
fi
