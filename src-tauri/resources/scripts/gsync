#!/bin/bash
# gsync — Reset current branch to match origin/main exactly.
# The branch becomes a clean copy of main under the same name.
# All local commits on the branch are discarded.
# Installed to ~/.rally/bin/ by Rally on startup

set -e

branch=$(git symbolic-ref --short HEAD 2>/dev/null)
main=main

if [ -z "$branch" ]; then echo "Not in a git repo"; exit 1; fi
if [ "$branch" = "$main" ]; then echo "Already on $main"; exit 1; fi
if [ -n "$(git status --porcelain)" ]; then
  echo "Working tree is dirty (uncommitted or untracked changes)."
  echo "Commit, stash, or clean first."
  exit 1
fi

rm -f .git/index.lock
git fetch origin "$main" || { echo "Fetch failed"; exit 1; }

echo "Resetting $branch to origin/$main..."
git reset --hard "origin/$main"

# Push the reset branch to remote
if git rev-parse --verify "origin/$branch" &>/dev/null; then
  git push --force-with-lease || { echo "Push failed"; exit 1; }
fi

echo "$branch is now identical to $main."
